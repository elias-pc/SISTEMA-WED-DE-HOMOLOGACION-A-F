# Para PostgreSQL local mediante Docker, use:
# DATABASE_URL=postgresql://af_user:af_password@127.0.0.1:5432/af_homologacion
# Déjelo vacío para ejecutar la demostración local con memoria temporal.
DATABASE_URL=
# URL directa (sin pooler) para aplicar migraciones. En local puede ser igual.
DATABASE_URL_UNPOOLED=
# Activar para conexiones TLS como Neon. En PostgreSQL local se mantiene false.
DATABASE_SSL=false
PORT=3001
APP_ORIGIN=http://localhost:4173
NODE_ENV=development
SESSION_TTL_HOURS=12
SEED_DEMO_PASSWORD=cambiar-antes-de-usar
SEED_SUPERVISOR_PASSWORD=cambiar-antes-de-usar

# Almacenamiento documental local. No use este driver en producción.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_PATH=./data/uploads
# Producción con Neon Object Storage: use DOCUMENT_STORAGE_DRIVER=neon-s3 y
# declare el bucket. Las variables AWS_* se generan con `neon env pull`.
NEON_STORAGE_BUCKET=

# Preparación para WhatsApp Cloud API. Mantener desactivado hasta contar con
# una cuenta Meta Business, número verificado y plantillas aprobadas.
NOTIFICATIONS_PROVIDER=disabled
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
CRON_SECRET=
