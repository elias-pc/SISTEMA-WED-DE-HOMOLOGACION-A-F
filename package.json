{
  "name": "af-homologacion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:server && node server/dev-runner.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server-dist/index.js",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "tsc && vite build && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "npm run build:server && node server-dist/db/migrate.js",
    "db:seed": "npm run build:server && node server-dist/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "start": "node server-dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "vitest": "^4.1.10"
  }
}
